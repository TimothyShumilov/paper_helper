# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL
POSTGRES_USER=arxiv_bot
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arxiv_bot

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=arxiv_chunks

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (GGUF via llama-cpp-python)
EMBEDDING_REPO_ID=enacimie/Qwen3-Embedding-0.6B-Q4_K_M-GGUF
EMBEDDING_FILENAME=qwen3-embedding-0.6b-q4_k_m.gguf
EMBEDDING_DIM=1024
MODELS_CACHE_DIR=/app/data/models

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_CHUNKS=5
MAX_HISTORY_TOKENS=120000

# Session
SESSION_TTL_HOURS=24
PDF_DOWNLOAD_DIR=/app/data/pdfs
